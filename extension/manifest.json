{
  "manifest_version": 3,
  "name": "AzureAutoFix",
  "version": "1.0.0",
  "description": "Automatically detects and fixes Azure AD authentication errors on Microsoft portal pages.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://*.microsoft.com/*",
    "https://*.azure.com/*",
    "https://*.microsoftonline.com/*",
    "http://localhost:8000/*",
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.microsoft.com/*",
        "https://*.azure.com/*",
        "https://*.microsoftonline.com/*",
        "http://localhost:8080/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
