# Azure App Registration
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here

# Backend
API_BASE=http://localhost:8000

# --- /fix endpoint safety switches ---
# If set, /fix requires this value in the X-API-Key header.
DEMO_API_KEY=

# If "true", /fix falls back to the app-level (client-credentials) Graph
# token when no access_token is supplied. Leave unset/false on any public
# deployment -- only enable for local testing against your own tenant.
ALLOW_APP_TOKEN_FALLBACK=false
